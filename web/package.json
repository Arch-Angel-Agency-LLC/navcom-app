    "@types/node": "^26.2.0",
    "marked": "^12.0.2",
    "node-html-parser": "^9.0.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vite-node": "^2.1.0"
  },
  "dependencies": {
    "@navcom/core": "file:../packages/core"
  }
}
